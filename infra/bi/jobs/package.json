{
  "name": "jobs-insights",
  "version": "0.1.0",
  "private": true,
  "description": "Jobs BI site: Evidence (open source) over the jobs Gold marts. Built and deployed by .github/workflows/jobs-marts.yml.",
  "scripts": {
    "sources": "SEND_ANONYMOUS_USAGE_STATS=no evidence sources --strict",
    "build": "SEND_ANONYMOUS_USAGE_STATS=no evidence build:strict && node scripts/offload-wasm.mjs",
